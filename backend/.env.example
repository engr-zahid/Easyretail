# Backend example environment variables
# Copy this file to .env and fill real values before running in any environment.

# Node env
NODE_ENV=production
PORT=5000

# Database (Postgres). Example: postgresql://user:password@host:5432/dbname
# For local development with docker-compose, use: postgresql://easyretail:easyretail123@postgres:5432/easyretail_db
DATABASE_URL=

# Prisma (optional) - only if separate shadow DB is used
#SHADOW_DATABASE_URL=

# Frontend URL used for CORS
FRONTEND_URL=
VITE_API_URL=

# JWT and secrets
JWT_SECRET=// This file was generated by Prisma, and assumes you have installed the following:
// npm install --save-dev prisma dotenv
import "dotenv/config";
import { defineConfig } from "prisma/config";

export default defineConfig({
  schema: "prisma/schema.prisma",
  migrations: {
    path: "prisma/migrations",
  },
  datasource: {
    url: process.env["DATABASE_URL"],
  },
});


# Cloudinary or other uploads (if used)
CLOUDINARY_URL=

# Other configuration
LOG_LEVEL=info
