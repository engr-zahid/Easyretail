generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          String     @id @default(uuid())
  name        String
  description String?
  price       Float
  quantity    Int
  category    String?
  image       String?
  status      String?
  sales       Int        @default(0)
  sku         String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  orderItems  OrderItem[]

  @@map("products")
}

model Customer {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  phone       String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  avatar      String?
  joinedDate  DateTime? @default(now())
  lastActive  DateTime? @default(now())
  notes       String?
  status      String?   @default("active")
  totalOrders Int?      @default(0)
  totalSpent  String?   @default("0.00")
  orders      Order[]
  
  @@map("customers")
}

model Supplier {
  id        String    @id @default(cuid())
  name      String
  email     String?   @unique
  phone     String?
  address   String?
  company   String?
  status    String    @default("active")
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  // If you have products, add this relation:
  // products Product[]
}

model Order {
  id            String     @id @default(uuid())
  orderNumber   String     @unique
  customerId    String?
  customer      Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  totalAmount   Float
  status        String     @default("PENDING")
  paymentMethod String     @default("CASH")
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  orderItems    OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  price     Float
  subtotal  Float

  @@map("order_items")
}